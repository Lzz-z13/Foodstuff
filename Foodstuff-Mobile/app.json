{
  "expo": {
    "name": "Foodstuff",
    "slug": "Foodstuff-Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF4B1F"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.lzzz13.FoodstuffMobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Foodstuff precisa acessar suas fotos para atualizar a foto de perfil."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "352605c0-55b2-422c-b632-e4d4aeebebeb"
      }
    }
  }
}
